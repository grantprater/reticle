{
  "attribution": {
    "commit": "",
    "sessionUrl": false
  },
  "env": {
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_MODEL": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "CLAUDE_CODE_SKIP_FAST_MODE_ORG_CHECK": "1",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "ENABLE_TOOL_SEARCH": "false",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/c/Users/grant/reticle/.venv/Scripts/python.exe /c/Users/grant/reticle/tools/guard_geometry.py --hook",
            "timeout": 60,
            "statusMessage": "Checking the art-derived geometry path"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/c/Users/grant/reticle/.venv/Scripts/python.exe /c/Users/grant/reticle/tools/guard_geometry.py >/dev/null 2>&1 || echo '{\"systemMessage\": \"GEOMETRY GUARD FAILED: the art-derived map path is broken. Run .venv/Scripts/python.exe tools/guard_geometry.py in ~/reticle to see what.\"}'",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
